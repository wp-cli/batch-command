{
    "name": "wp-cli/batch-command",
    "type": "wp-cli-package",
    "description": "Runs many WP-CLI commands while loading WordPress only once.",
    "homepage": "https://github.com/wp-cli/batch-command",
    "license": "MIT",
    "authors": [],
    "require": {
        "wp-cli/wp-cli": "^3"
    },
    "require-dev": {
        "wp-cli/entity-command": "^1.3 || ^2 || ^3",
        "wp-cli/extension-command": "^1.2 || ^2 || ^3",
        "wp-cli/wp-cli-tests": "^5"
    },
    "config": {
        "process-timeout": 7200,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev"
        },
        "bundled": false,
        "commands": [
            "batch",
            "batch run"
        ]
    },
    "autoload": {
        "psr-4": {
            "WP_CLI\\Batch\\": "src/"
        },
        "files": [
            "batch-command.php"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "behat": "run-behat-tests",
        "behat-rerun": "rerun-behat-tests",
        "lint": "run-linter-tests",
        "lint-gherkin": "run-gherkin-lint-tests",
        "phpcs": "run-phpcs-tests",
        "phpstan": "run-phpstan-tests",
        "phpcbf": "run-phpcbf-cleanup",
        "phpunit": "run-php-unit-tests",
        "prepare-tests": "install-package-tests",
        "test": [
            "@lint",
            "@lint-gherkin",
            "@phpcs",
            "@phpstan",
            "@phpunit",
            "@behat"
        ]
    },
    "support": {
        "issues": "https://github.com/wp-cli/batch-command/issues"
    }
}
